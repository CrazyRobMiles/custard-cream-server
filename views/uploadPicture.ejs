<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.0.0-beta1/dist/css/bootstrap.min.css" rel="stylesheet"
        integrity="sha384-giJF6kkoqNQ00vy+HMDP7azOuL0xtbfIcaT9wjKHr8RbDVddVHyTfAAsrekwKmP1" crossorigin="anonymous">
    <title>Custard Cream Server - Upload Picture</title>
</head>

<body>
    <div class="container mb-4">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h1>Upload Picture</h1>
            <a href="/manage" class="btn btn-outline-secondary">Back to gallery</a>
        </div>

        <div class="mb-3">
            <label for="uploadFile" class="form-label">Image (JPEG or PNG)</label>
            <input type="file" id="uploadFile" class="form-control" accept="image/jpeg,image/png">
        </div>

        <div class="mb-3">
            <label class="form-label d-block">Tags</label>
            <div id="uploadTagOptions" class="mb-2">Loading tags...</div>
            <label for="uploadNewTags" class="form-label">Add new tags (comma separated)</label>
            <input type="text" id="uploadNewTags" class="form-control" placeholder="e.g. workshop,friday">
        </div>

        <button type="button" id="uploadBtn" class="btn btn-primary">Upload</button>
        <p id="uploadStatus" class="mt-3"></p>
    </div>

    <script src="/public/uploadPicture.js"></script>
</body>

</html>

<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.0.0-beta1/dist/css/bootstrap.min.css" rel="stylesheet"
        integrity="sha384-giJF6kkoqNQ00vy+HMDP7azOuL0xtbfIcaT9wjKHr8RbDVddVHyTfAAsrekwKmP1" crossorigin="anonymous">
    <title>Custard Cream Server - Slideshow</title>
</head>

<body>
    <div class="container mb-4">
        <a href="/" class="btn btn-outline-secondary mb-4">Home</a>

        <h1 class="mb-4">Slideshow</h1>
        <p id="description">Pictures dropped onto a table, one at a time, chosen at random from everything uploaded.</p>

        <div class="mb-3">
            <label class="form-label">Only show pictures tagged with:</label>
            <div id="tagList" class="mb-2">Loading tags...</div>
        </div>

        <button id="startBtn" class="btn btn-primary">Start slideshow</button>
    </div>

    <script src="/public/slideshowStart.js"></script>
</body>

</html>
